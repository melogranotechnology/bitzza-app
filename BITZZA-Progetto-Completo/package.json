{
  "name": "bitzza-app",
  "version": "1.0.0",
  "description": "BITZZA Wallet Service - A decentralized payment platform for sustainable agriculture",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "dev:web": "npm --prefix frontend/web run dev -- --host 127.0.0.1",
    "lint:web": "npm --prefix frontend/web run lint",
    "build:web": "npm --prefix frontend/web run build",
    "test": "jest --runInBand",
    "check": "npm test && npm run lint:web && npm run build:web"
  },
  "keywords": ["wallet", "payment", "blockchain", "agriculture", "sustainability"],
  "author": "BITZZA Team",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "sqlite3": "^5.1.6",
    "jsonwebtoken": "^9.0.2",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.3.1",
    "cors": "^2.8.5"
  },
  "devDependencies": {
    "jest": "^29.6.2",
    "nodemon": "^3.0.1"
  }
}
